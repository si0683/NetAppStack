<ui:FluentWindow
  x:Class="StarterApp.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:vm="clr-namespace:StarterApp.ViewModels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
  Title="Настройки"
  Width="620" Height="640" MinWidth="480" MinHeight="400"
  WindowStartupLocation="CenterOwner"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  ShowInTaskbar="False"
  Language="ru-RU">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Настройки" ShowMinimize="False" ShowMaximize="False" />

    <ScrollViewer Grid.Row="1" Padding="20,4,20,0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Сбор данных" />
        <TextBlock Margin="0,12,0,4" Text="Собирать каждые, минут" />
        <ui:NumberBox Width="160" HorizontalAlignment="Left" Minimum="1" Maximum="1440"
                      SmallChange="5" LargeChange="60" MaxDecimalPlaces="0"
                      Value="{Binding UpdateIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox Margin="0,12,0,0" Content="Демо-источник (придуманные записи)" IsChecked="{Binding DemoEnabled}" />

        <TextBlock Margin="0,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Источник «список на веб-странице»" />
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Адрес страницы и CSS-селекторы. Пустой адрес — источник выключен." />
        <TextBlock Margin="0,12,0,4" Text="Адрес" />
        <ui:TextBox PlaceholderText="https://…" Text="{Binding WebUrl}" />
        <UniformGrid Margin="0,8,0,0" Columns="2">
          <StackPanel Margin="0,0,8,8">
            <TextBlock Margin="0,0,0,4" Text="Элемент списка" />
            <ui:TextBox Text="{Binding WebItemSelector}" />
          </StackPanel>
          <StackPanel Margin="0,0,0,8">
            <TextBlock Margin="0,0,0,4" Text="Ссылка (внутри элемента)" />
            <ui:TextBox Text="{Binding WebLinkSelector}" />
          </StackPanel>
          <StackPanel Margin="0,0,8,0">
            <TextBlock Margin="0,0,0,4" Text="Дата" />
            <ui:TextBox Text="{Binding WebDateSelector}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Margin="0,0,0,4" Text="Категория" />
            <ui:TextBox Text="{Binding WebCategorySelector}" />
          </StackPanel>
        </UniformGrid>
<!--#if (postgres) -->

        <TextBlock Margin="0,24,0,0" FontSize="16" FontWeight="SemiBold" Text="База PostgreSQL" />
        <TextBlock Margin="0,12,0,4" Text="Строка подключения (применится после перезапуска)" />
        <ui:TextBox Text="{Binding PostgresConnection}" />
<!--#endif -->

        <TextBlock Margin="0,24,0,0" FontSize="16" FontWeight="SemiBold" Text="Внешний вид" />
        <TextBlock Margin="0,12,0,4" Text="Тема" />
        <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Themes}"
                  SelectedItem="{Binding Theme}" DisplayMemberPath="Title" />
<!--#if (tray) -->
        <CheckBox Margin="0,12,0,0" Content="Крестик сворачивает в трей (сбор продолжается)" IsChecked="{Binding MinimizeToTray}" />
<!--#endif -->
<!--#if (updates) -->
        <CheckBox Margin="0,12,0,0" Content="Проверять обновления при запуске" IsChecked="{Binding CheckUpdates}" />
<!--#endif -->
        <Border Height="16" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="20,12,20,20" HorizontalAlignment="Right" Orientation="Horizontal">
      <ui:Button Appearance="Primary" Content="Сохранить" IsDefault="True" MinWidth="110" Click="OnSave" />
      <ui:Button Margin="8,0,0,0" Content="Отмена" IsCancel="True" MinWidth="110" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
