<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StarterApp</AssemblyName>
    <RootNamespace>StarterApp</RootNamespace>
    <StartupObject>StarterApp.Program</StartupObject>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>StarterApp</Product>
    <AssemblyTitle>StarterApp</AssemblyTitle>
    <Description>StarterApp</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
<!--#if (charts) -->
    <!-- SkiaSharp.Views.WPF (внутри ScottPlot) собран под .NET Framework, но работает — предупреждение лишнее -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
<!--#endif -->
  </PropertyGroup>

  <!-- выпуск: один exe без установки .NET (dotnet publish -c Release).
       Без сжатия — сжатые exe чаще ловят ложные срабатывания антивирусов. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StarterApp.Core/StarterApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
<!--#if (charts) -->
    <PackageReference Include="ScottPlot.WPF" />
<!--#endif -->
<!--#if (tray) -->
    <PackageReference Include="H.NotifyIcon.Wpf" />
<!--#endif -->
<!--#if (updates) -->
    <PackageReference Include="Velopack" />
<!--#endif -->
  </ItemGroup>

</Project>
